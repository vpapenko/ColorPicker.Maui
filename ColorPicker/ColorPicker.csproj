<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>

		<!-- Ship XML docs in the package for consumer IntelliSense. CS1591 (missing
		     doc on a public member) is suppressed so undocumented internals-that-
		     happen-to-be-public don't add warning noise; the consumer-facing API is
		     documented. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>

		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>
		<Platforms>AnyCPU;x64</Platforms>

		<!-- CI supplies package versions independently for stable releases and
		     as a coherent pair for preview builds. Assembly versions stay stable. -->
		<Version Condition="'$(ColorPickerMauiVersion)' != ''">$(ColorPickerMauiVersion)</Version>
		<Version Condition="'$(ColorPickerMauiVersion)' == ''">0.0.0-local</Version>
		<PackageVersion>$(Version)</PackageVersion>
		<IsPackable>true</IsPackable>
		<PackageId>ColorPicker.Maui</PackageId>
		<Authors>Victor Papenko</Authors>
		<Company>Victor Papenko</Company>
		<Copyright>Copyright (c) $([System.DateTime]::Now.Year) Victor Papenko</Copyright>
		<Description>SkiaSharp-based color picker controls for .NET MAUI: ColorWheel, ColorTriangle, HSL/RGB sliders, and a luminance/alpha-aware composite picker.</Description>
		<PackageTags>maui;colorpicker;color-picker;skiasharp;controls;ui</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/vpapenko/ColorPicker.Maui</PackageProjectUrl>
		<RepositoryUrl>https://github.com/vpapenko/ColorPicker.Maui</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Reproducible / debuggable builds. -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<!-- MAUI 10 / SkiaSharp 4.x. MAUI is pinned to the version shipping with the
	     global.json SDK band to avoid pulling unpublished runtime packs (NU1102);
	     bump it in lockstep with the SDK. -->
	<ItemGroup>
	  <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
	  <PackageReference Include="SkiaSharp" Version="4.151.1" />
	  <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.1" />
	</ItemGroup>

	<ItemGroup>
	  <!-- Build-time only: embed source links. -->
	  <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\README.md" Pack="true" PackagePath="\" />
	  <None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ColorPicker.Core\ColorPicker.Core.csproj"
	                    Condition="'$(UseCorePackageReference)' != 'true'" />
	  <PackageReference Include="ColorPicker.Maui.Core"
	                    Version="$(ColorPickerCoreDependencyVersion)"
	                    Condition="'$(UseCorePackageReference)' == 'true'" />
	</ItemGroup>

	<Target Name="ValidateCorePackageReferenceVersion"
	        BeforeTargets="CollectPackageReferences"
	        Condition="'$(UseCorePackageReference)' == 'true' and '$(ColorPickerCoreDependencyVersion)' == ''">
		<Error Text="ColorPickerCoreDependencyVersion is required when UseCorePackageReference=true." />
	</Target>

</Project>
