<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ColorPickerTestApp.LayoutTestPage"
             Title="Layout Test"
             BackgroundColor="White">
    <Grid RowDefinitions="Auto,Auto,*" Padding="0">
        <HorizontalStackLayout Grid.Row="0" Padding="6" Spacing="6" BackgroundColor="LightGray">
            <Entry x:Name="ScenarioEntry"
                   AutomationId="ScenarioEntry"
                   Text="wheel:300x300"
                   WidthRequest="320" />
            <Button x:Name="ApplyButton"
                    AutomationId="ApplyScenario"
                    Text="Apply"
                    Clicked="OnApplyClicked" />
            <Button x:Name="CaptureButton"
                    AutomationId="CaptureCanvas"
                    Text="Capture"
                    Clicked="OnCaptureClicked" />
            <Label x:Name="StatusLabel"
                   AutomationId="ScenarioStatus"
                   VerticalOptions="Center"
                   Text="ready" />
            <Label x:Name="CapturePathLabel"
                   AutomationId="CapturePath"
                   VerticalOptions="Center"
                   Text="" />
        </HorizontalStackLayout>

        <!-- Marker label tests can poll to detect when Apply finished, plus
             actual measured bounds (UIA size queries on a constrained Border
             are unreliable in MAUI/WinUI). Format: "spec|hostWxH|ctrlWxH" -->
        <VerticalStackLayout Grid.Row="1">
            <Label x:Name="AppliedLabel"
                   AutomationId="ScenarioApplied"
                   Text="initial" />
            <!-- DEBUG: step-by-step trace of the last ApplyScenario call.
                 Drives the regression-isolation tests. -->
            <Label x:Name="DebugTraceLabel"
                   AutomationId="DebugTrace"
                   Text=""
                   FontSize="6"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- Outer host: top-left aligned so screen position is predictable.
             Wrapped in HostContainer (a Grid filling row 2) so tests can
             observe the viewport size available to Fill-mode hosts. -->
        <Grid Grid.Row="2"
              x:Name="HostContainer"
              AutomationId="HostContainer"
              SizeChanged="OnHostSizeChanged">
            <!-- Container outline removed: blue border is now on HostBorder
                 itself so it visually marks the requested cell. -->
                <Border x:Name="HostBorder"
                        AutomationId="ScenarioHost"
                        StrokeThickness="2"
                        Stroke="Blue"
                        Background="Yellow"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Padding="0"
                        Margin="0"
                        SizeChanged="OnHostSizeChanged">
                    <!-- 1px picker outline: wraps just the actual control so the
                         red stroke reflects the control's *useful* footprint
                         (which, for aspect-locked controls, is smaller than the
                         requested cell — e.g. a wheel asked for 300×600 has a
                         300×300 useful area). HO/VO=Start anchors it to the
                         top-left of the (possibly larger) HostBorder cell. -->
                    <Border x:Name="PickerOutline"
                            StrokeThickness="1"
                            Stroke="Red"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Padding="0"
                            Margin="0"
                            SizeChanged="OnPickerOutlineSizeChanged">
                        <ContentView x:Name="ScenarioContent"
                                     AutomationId="ScenarioContent"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Start"
                                     SizeChanged="OnHostSizeChanged" />
                    </Border>
                </Border>
            </Grid>
    </Grid>
</ContentPage>
